# Copy to .env and fill in. Nothing here is a real credential.

NEXT_PUBLIC_DOMAIN=http://localhost:3000
NEXT_PUBLIC_API_DOMAIN=http://localhost:3000/api

MONGODB_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_URL_INTERNAL=http://localhost:3000
NEXTAUTH_SECRET=

# Comma separated emails that are promoted to admin on sign in. This is how the
# first admin account is created, since only an admin can promote another one.
ADMIN_EMAILS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_GEOCODING_API_KEY=

# --- Booking deposits ---------------------------------------------------
# Share of the stay total taken up front. NEXT_PUBLIC_ because the booking UI
# quotes the same percentage it charges.
NEXT_PUBLIC_BOOKING_DEPOSIT_PERCENT=20

# eSewa ePay v2. The defaults are eSewa's own published test merchant, so the
# sandbox flow works with these left blank.
# Test logins: 9711111111 / Nepal@123, OTP 123456
ESEWA_ENV=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti ePayment (KPG-2). No shared sandbox merchant exists, so Khalti stays
# hidden in the UI until a key is set. Get one from https://test-admin.khalti.com
# Test logins: 9800000000 / MPIN 1111, OTP 987654
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
